DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=medcore
DATABASE_USER=medcore
DATABASE_PASSWORD=replace-with-local-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60
DATABASE_TEST_NAME=medcore_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

JWT_SIGNING_KEY=replace-with-a-dedicated-jwt-signing-secret
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_AUTH_MAX_AGE=86400
TELEGRAM_AUTH_FUTURE_SKEW=60
AUTH_REFRESH_COOKIE_SECURE=false
OPENAPI_PUBLIC=true

# Integration credential for the external content API. Empty denies every
# integration request.
MEDCORE_CONTENT_API_KEY=replace-with-a-dedicated-integration-secret

# Media object storage. `local` is a dev/test backend only and is refused when
# DEBUG is false; `s3` is any S3-compatible provider (MinIO, AWS S3, ...) and
# needs the optional `storage-s3` dependency group.
MEDIA_STORAGE_BACKEND=local
# Defaults to <repo>/media-storage when unset; leave unset to use the default.
# MEDIA_STORAGE_ROOT=/absolute/path/to/media-storage
MEDIA_S3_ENDPOINT_URL=http://127.0.0.1:9000
MEDIA_S3_BUCKET=medcore-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY=replace-with-object-storage-access-key
MEDIA_S3_SECRET_KEY=replace-with-object-storage-secret-key
MEDIA_S3_ADDRESSING_STYLE=path
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_UPLOAD_URL_TTL=600
MEDIA_ACCESS_URL_TTL=600

# Robokassa payment provider integration (BE-006)
ROBOKASSA_MERCHANT_LOGIN=medcore_test
ROBOKASSA_PASSWORD_1=replace-with-robokassa-password-1
ROBOKASSA_PASSWORD_2=replace-with-robokassa-password-2
ROBOKASSA_HASH_ALGORITHM=sha256
ROBOKASSA_TEST_MODE=true
ROBOKASSA_BASE_URL=https://auth.robokassa.ru/Merchant/Index.aspx

