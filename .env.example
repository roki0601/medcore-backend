DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=medcore
DATABASE_USER=medcore
DATABASE_PASSWORD=replace-with-local-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60
DATABASE_TEST_NAME=medcore_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

JWT_SIGNING_KEY=replace-with-a-dedicated-jwt-signing-secret
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_AUTH_MAX_AGE=86400
TELEGRAM_AUTH_FUTURE_SKEW=60
AUTH_REFRESH_COOKIE_SECURE=false
OPENAPI_PUBLIC=true
